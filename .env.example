# ===================================================================
#  JMJob / EarnApp — production .env example
#  Copy to .env on the server and adjust as needed.
# ===================================================================

# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------
APP_NAME="JMJob"
APP_ENV=production
APP_KEY=                           # Generate with: php nemesis key:generate
APP_DEBUG=false
APP_URL=https://jmjob.xyz
APP_TIMEZONE=UTC
APP_LOCALE=en

# -------------------------------------------------------------------
# Database — MySQL (production)
# -------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jmjobxyz_db
DB_USER=jmjobxyz_db
DB_PASS=jmjobxyz_db

# -------------------------------------------------------------------
# Cache
# -------------------------------------------------------------------
CACHE_DRIVER=file
CACHE_PREFIX=jmjob_
CACHE_TTL=3600
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1

# -------------------------------------------------------------------
# Session
# -------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=jmjob_session
SESSION_SECURE_COOKIE=true

# -------------------------------------------------------------------
# Mail (not used by EarnApp, but required by Nemesis boot)
# -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM=hello@jmjob.xyz
MAIL_FROM_NAME="JMJob"

# -------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_DAYS=7

# -------------------------------------------------------------------
# EarnApp-specific config
# -------------------------------------------------------------------
# GigaPub (optional) — Telegram-native ad network
AD_PROVIDER_GIGAPUB_ID=

# TgAds / AdExium (optional)
AD_PROVIDER_TGADS_ID=

# Reward per ad view (USD)
AD_REWARD_PER_VIEW=0.0050

# Daily ad cap per user
AD_DAILY_LIMIT=50

# Minimum seconds user must watch an ad
AD_MIN_DURATION_SECONDS=12

# Withdrawals
WITHDRAW_MIN_REFERRALS=1
WITHDRAW_MIN_AMOUNT=1.00

# Referral commission (0.50 = 50% lifetime)
REFERRAL_COMMISSION_RATE=0.50
