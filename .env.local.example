# JMJob — local development .env template
# Copy to .env on your dev machine.
#   cp .env.local.example .env
#   php -r "echo bin2hex(random_bytes(32));"   # generate APP_KEY
#   # then paste into .env
#   composer install --no-interaction --no-scripts
#   composer remove --no-scripts aws/aws-sdk-php league/flysystem-aws-s3-v3
#   php nemesis migrate:run
#   php nemesis db:seed EarnAppSeeder
#   php -S 127.0.0.1:8080 -t public/

APP_NAME="JMJob (local)"
APP_ENV=local
APP_DEBUG=true
APP_KEY=                                      # generate with: php -r "echo bin2hex(random_bytes(32));"
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC
APP_LOCALE=en

# Database — local MySQL (default)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=earn_db
DB_USER=root
DB_PASS=root

# Cache / Queue / Session / Logging
CACHE_DRIVER=file
CACHE_PREFIX=jmjob_
QUEUE_DRIVER=sync
SESSION_DRIVER=file
SESSION_COOKIE=jmjob_session
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Ad provider config (optional — leave empty for simulated ads)
AD_PROVIDER_GIGAPUB_ID=
AD_PROVIDER_TGADS_ID=
AD_REWARD_PER_VIEW=0.0050
AD_DAILY_LIMIT=50
AD_MIN_DURATION_SECONDS=12

WITHDRAW_MIN_REFERRALS=1
REFERRAL_COMMISSION_RATE=0.50
